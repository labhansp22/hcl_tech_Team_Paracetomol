# LLM providers, tried in this order. Free keys:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
# Put your real keys in .env (never in this file: it is committed to git).
LLM_CHAIN=groq,gemini

# API keys: one key, or several comma-separated (no spaces needed). Several keys are load-balanced
# round robin, and a failing key fails over to the next one. Use keys from DIFFERENT accounts
# (e.g. one per teammate): free-tier limits are per account, so two keys from one account share one quota.
#   GROQ_API_KEY=gsk_first,gsk_second,gsk_third
GROQ_API_KEY=
GEMINI_API_KEY=

# Models per provider, comma-separated, tried in order: each free model has its own daily quota.
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash
